<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TFG ADE · Análisis PLN de Sostenibilidad · STOXX Europe 600</title>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    /* Paleta institucional UE + tecnológica + sostenibilidad */
    --navy: #0a1d36;
    --navy-2: #102b4e;
    --steel: #1c3a5e;
    --blue: #1f5fa6;
    --blue-soft: #e8eff6;
    --green: #157347;
    --green-soft: #e6f2ec;
    --gold: #c2992b;
    --gold-soft: #f6efda;
    --bg: #eef1f5;
    --card: #ffffff;
    --ink: #15212e;
    --muted: #5d6b7a;
    --line: #d8dee6;
    --line-soft: #e7ebf0;
    --shadow: 0 1px 2px rgba(16,43,78,.06), 0 8px 24px rgba(16,43,78,.06);
    --radius: 12px;
    --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --sans: "IBM Plex Sans", -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --serif: "IBM Plex Serif", Georgia, "Times New Roman", serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; font-family: var(--sans); background: var(--bg); color: var(--ink);
    font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased;
  }

  /* ── Cabecera institucional ── */
  header {
    position: relative; color: #eaf1fb; padding: 0;
    background:
      radial-gradient(1200px 320px at 85% -40%, rgba(31,95,166,.45), transparent 60%),
      linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 55%, var(--steel) 100%);
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  header::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background-image:
      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  .header-accent { height: 4px; background: linear-gradient(90deg, var(--gold) 0%, var(--gold) 40%, var(--green) 40%, var(--green) 100%); }
  .header-inner { position: relative; max-width: 1400px; margin: 0 auto; padding: 30px 36px 34px; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 9px; font-family: var(--mono);
    font-size: .72rem; letter-spacing: .16em; text-transform: uppercase;
    color: #9fc0e8; margin-bottom: 14px;
  }
  .eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 4px rgba(194,153,43,.18); }
  .eyebrow .sep { opacity: .4; }
  header h1 {
    font-family: var(--serif); font-weight: 600; margin: 0 0 12px; font-size: 1.92rem;
    line-height: 1.18; letter-spacing: -.01em; color: #fff; max-width: 960px;
  }
  header p {
    margin: 0; max-width: 940px; line-height: 1.62; font-size: .94rem; color: #c2d4ea;
  }
  header p b { color: #fff; font-weight: 600; }
  .header-tags { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 8px; }
  .header-tags span {
    font-family: var(--mono); font-size: .72rem; letter-spacing: .04em; color: #cfe0f4;
    border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.05);
    padding: 4px 11px; border-radius: 999px;
  }

  /* ── Navegación ── */
  nav.tabs {
    display: flex; flex-wrap: wrap; gap: 2px; background: rgba(255,255,255,.92);
    backdrop-filter: saturate(180%) blur(8px); border-bottom: 1px solid var(--line);
    padding: 0 28px; position: sticky; top: 0; z-index: 20; box-shadow: 0 1px 0 rgba(16,43,78,.04);
  }
  nav.tabs button {
    border: none; background: none; padding: 15px 18px 13px; font-size: .92rem; cursor: pointer;
    color: var(--muted); border-bottom: 2.5px solid transparent; font-weight: 600;
    font-family: var(--sans); letter-spacing: .01em; transition: color .15s, border-color .15s;
  }
  nav.tabs button:hover { color: var(--steel); }
  nav.tabs button.active { color: var(--navy); border-bottom-color: var(--gold); }

  main { padding: 30px 36px 72px; max-width: 1400px; margin: 0 auto; }
  .tab-content { display: none; animation: fade .25s ease; }
  .tab-content.active { display: block; }
  @keyframes fade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

  /* ── Tarjetas KPI ── */
  .card-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 26px; }
  .stat-card {
    position: relative; background: var(--card); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 20px 22px 18px; flex: 1; min-width: 168px;
    box-shadow: var(--shadow); overflow: hidden;
  }
  .stat-card::before { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: linear-gradient(90deg, var(--green), var(--blue)); }
  .stat-card .value { font-family: var(--mono); font-size: 2rem; font-weight: 600; color: var(--navy); letter-spacing: -.02em; }
  .stat-card .value small { font-size: .9rem; color: var(--muted); }
  .stat-card .label { font-size: .8rem; color: var(--muted); margin-top: 5px; font-weight: 500; }

  /* ── Tipografía de secciones ── */
  h2 {
    font-family: var(--serif); font-weight: 600; font-size: 1.36rem; color: var(--navy);
    margin: 42px 0 18px; padding-bottom: 10px; position: relative; letter-spacing: -.01em;
  }
  h2::after { content: ""; position: absolute; bottom: 0; left: 0; width: 56px; height: 3px; background: var(--gold); border-radius: 2px; }
  h2::before { content: ""; position: absolute; bottom: 0; left: 0; width: 100%; height: 1px; background: var(--line); }
  h3 { font-family: var(--sans); font-weight: 600; font-size: 1.05rem; color: var(--steel); margin-top: 26px; }
  h4 { font-family: var(--sans); font-weight: 600; font-size: .96rem; color: var(--steel); margin: 16px 0 8px; }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 900px) { .grid-2 { grid-template-columns: 1fr; } }

  .chart-box, .img-box {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 12px; margin-bottom: 18px; box-shadow: var(--shadow);
  }
  .chart-box { height: 420px; }
  .img-box { padding: 16px; text-align: center; }
  .img-box img { max-width: 100%; border-radius: 8px; }
  .img-box figcaption { font-family: var(--mono); font-size: .78rem; color: var(--muted); margin-top: 10px; letter-spacing: .02em; }
  .chart-box[id^="emp-chart"], .chart-box[id^="comp-chart"] { padding: 6px; }

  /* ── Tablas ── */
  .table-wrap {
    overflow-x: auto; margin-bottom: 18px; border: 1px solid var(--line);
    border-radius: var(--radius); box-shadow: var(--shadow); background: var(--card);
    -webkit-overflow-scrolling: touch;
  }
  .table-wrap::-webkit-scrollbar { height: 9px; }
  .table-wrap::-webkit-scrollbar-thumb { background: var(--line); border-radius: 999px; }
  .table-wrap::-webkit-scrollbar-thumb:hover { background: #c2cad4; }
  table.data-table, table.dataframe {
    border-collapse: collapse; width: 100%; font-size: .85rem; background: var(--card);
    color: var(--ink);
  }
  table.data-table th, table.data-table td,
  table.dataframe th, table.dataframe td {
    border-bottom: 1px solid var(--line-soft); padding: 9px 14px; text-align: left;
    white-space: nowrap; vertical-align: top;
  }
  table.data-table thead th, table.dataframe thead th {
    position: sticky; top: 0; z-index: 1; background: var(--navy); color: #eaf1fb;
    font-family: var(--sans); font-weight: 600; font-size: .76rem; letter-spacing: .04em;
    text-transform: uppercase; border-bottom: 2px solid var(--gold); white-space: nowrap;
  }
  /* Números en monoespaciada y alineados */
  table.data-table tbody td, table.dataframe tbody td { font-family: var(--mono); font-size: .82rem; font-variant-numeric: tabular-nums; }
  table.data-table tbody td:first-child, table.dataframe tbody td:first-child { font-family: var(--sans); font-weight: 600; color: var(--steel); }
  table.data-table tbody tr:nth-child(even), table.dataframe tbody tr:nth-child(even) { background: #f7f9fb; }
  table.data-table tbody tr:hover, table.dataframe tbody tr:hover { background: var(--blue-soft); }
  table.data-table tbody tr:last-child td, table.dataframe tbody tr:last-child td { border-bottom: none; }
  /* Columnas de texto largo (palabras, representación) permiten ajuste */
  td.col-wrap, .table-wrap td.wrap { white-space: normal; min-width: 320px; max-width: 560px; line-height: 1.45; }
  table.lda-table td:last-child { white-space: normal; min-width: 360px; max-width: 620px; line-height: 1.5; }

  /* ── Controles ── */
  .control-bar { margin-bottom: 18px; }
  .control-bar label, .slider-row label { font-family: var(--sans); font-weight: 600; color: var(--steel); font-size: .9rem; }
  select#empresa-select, select#comp-year {
    font-family: var(--sans); font-size: .95rem; padding: 10px 14px; border-radius: 9px;
    border: 1px solid var(--line); min-width: 280px; background: var(--card); color: var(--ink);
    box-shadow: var(--shadow); margin-top: 6px; cursor: pointer;
  }
  select:focus { outline: 2px solid var(--blue); outline-offset: 1px; }
  .checkbox-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 6px 14px; max-height: 230px; overflow-y: auto; border: 1px solid var(--line);
    border-radius: var(--radius); padding: 14px; background: var(--card); margin-bottom: 18px;
    box-shadow: var(--shadow);
  }
  .checkbox-grid label { font-size: .84rem; display: flex; gap: 8px; align-items: center; cursor: pointer; color: var(--ink); }
  .checkbox-grid input { accent-color: var(--green); }
  .slider-row { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
  .slider-row input[type="range"] { accent-color: var(--gold); }
  .slider-row span { font-family: var(--mono); font-weight: 600; color: var(--navy); }

  /* ── Cuadros de hallazgos (estilo "considerando" legislativo) ── */
  .findings {
    background: linear-gradient(180deg, var(--gold-soft), #fff); border: 1px solid var(--line);
    border-left: 4px solid var(--gold); padding: 16px 22px; border-radius: 0 var(--radius) var(--radius) 0;
    margin: 18px 0; line-height: 1.65; font-size: .92rem; color: var(--ink); box-shadow: var(--shadow);
  }
  .findings b { color: var(--navy); }
  .findings ul { margin: 8px 0; padding-left: 22px; }
  .findings li { margin: 4px 0; }

  /* ── Sub-pestañas (RQ / Topics) ── */
  .rq-tabs { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
  .rq-tabs button {
    border: 1px solid var(--line); background: var(--card); color: var(--steel); border-radius: 999px;
    padding: 9px 20px; cursor: pointer; font-weight: 600; font-size: .88rem; font-family: var(--sans);
    box-shadow: var(--shadow); transition: all .15s;
  }
  .rq-tabs button:hover { border-color: var(--blue); color: var(--blue); }
  .rq-tabs button.active { background: var(--navy); color: #fff; border-color: var(--navy); }
  .rq-content { display: none; }
  .rq-content.active { display: block; animation: fade .2s ease; }

  details {
    background: var(--card); border: 1px solid var(--line); border-radius: 9px;
    padding: 4px 14px; margin: 10px 0; box-shadow: var(--shadow);
  }
  details summary { cursor: pointer; font-weight: 600; color: var(--blue); padding: 8px 0; font-size: .9rem; }
  code {
    font-family: var(--mono); font-size: .85em; background: var(--blue-soft); color: var(--steel);
    padding: 1px 6px; border-radius: 5px;
  }
  p { color: var(--ink); }

  footer {
    text-align: center; color: var(--muted); font-family: var(--mono); font-size: .76rem;
    padding: 32px; border-top: 1px solid var(--line); margin-top: 24px; letter-spacing: .02em;
  }
</style>
</head>
<body>

<header>
  <div class="header-accent"></div>
  <div class="header-inner">
    <div class="eyebrow">
      <span class="dot"></span> TFG · ADE · Universitat de València
      <span class="sep">/</span> Marco CSRD · ESRS · Taxonomía UE
    </div>
    <h1>Comunicación corporativa de sostenibilidad en el STOXX&nbsp;Europe&nbsp;600</h1>
    <p>
      Análisis de contenido mediante técnicas de inteligencia artificial sobre
      <b>{{ summary.n_docs }} secciones de sostenibilidad</b> de <b>{{ summary.n_empresas }} empresas europeas</b>
      (2022–2024). Resultados de la Fase 5 (PLN) bajo el marco normativo CSRD/ESRS. Todo el análisis es
      <b>textual</b> —FinBERT, ClimateBERT, diccionario Loughran-McDonald y diccionario ESRS propio—
      <b>sin recurrir a ratings ESG de terceros</b>.
    </p>
    <div class="header-tags">
      <span>FinBERT</span><span>ClimateBERT</span><span>Loughran-McDonald</span>
      <span>Diccionario ESRS</span><span>LDA + BERTopic</span><span>GW-index</span>
    </div>
  </div>
</header>

<nav class="tabs">
  <button class="tab-btn active" data-tab="overview">Panorámica</button>
  <button class="tab-btn" data-tab="explorador">Explorador de empresa</button>
  <button class="tab-btn" data-tab="topics">Tópicos</button>
  <button class="tab-btn" data-tab="comparador">Comparador</button>
  <button class="tab-btn" data-tab="rq">Resultados RQ</button>
</nav>

<main>

  <!-- ============ OVERVIEW ============ -->
  <section id="overview" class="tab-content active">
    <div class="card-row">
      <div class="stat-card"><div class="value">{{ summary.n_empresas }}</div><div class="label">Empresas</div></div>
      <div class="stat-card"><div class="value">{{ summary.n_docs }}</div><div class="label">Documentos (sección sostenibilidad)</div></div>
      <div class="stat-card"><div class="value">{{ summary.n_paises }}</div><div class="label">Países</div></div>
      <div class="stat-card"><div class="value">{{ summary.n_supersectores }}</div><div class="label">Supersectores ICB</div></div>
    </div>

    <h2>Tamaño del corpus por sección y año</h2>
    <div class="grid-2">
      <div class="chart-box" id="chart-tokens-sus"></div>
      <div class="chart-box" id="chart-tokens-mr"></div>
    </div>
    <p class="findings">Crecimiento +83% en media (+147% en mediana) en la sección de sostenibilidad (11.2k → 20.5k tokens de media, 6.9k → 17.0k mediana, 2022→2024) — señal RQ4 (NFRD→CSRD). El management report (`mr`) se mantiene estable (~38-41k tokens).</p>
    <div class="table-wrap">{{ desc_table | safe }}</div>

    <h2>Cobertura ESRS (diccionario v1.1, 11 categorías)</h2>
    <div class="img-box">
      <img src="../figures/5a_heatmap_esrs.png" alt="Heatmap cobertura ESRS">
    </div>
    <h3>Evolución de la cobertura ESRS por año</h3>
    <div class="chart-box" id="chart-esrs-evolution"></div>
    <p class="findings">E1 (cambio climático) y S1 (plantilla propia) son las categorías mejor cubiertas en todos los años; E2 (contaminación) la peor.</p>

    <h2>Composición de la muestra ({{ summary.n_docs }} documentos `sus`)</h2>
    <div class="grid-2">
      <div class="chart-box" id="chart-by-supersector"></div>
      <div class="chart-box" id="chart-by-country"></div>
    </div>

    <h2>Léxico distintivo (TF-IDF)</h2>
    <div class="grid-2">
      <figure class="img-box"><img src="../figures/5a_tfidf_top_sus.png" alt="TF-IDF sostenibilidad"><figcaption>Top TF-IDF — sección sostenibilidad</figcaption></figure>
      <figure class="img-box"><img src="../figures/5a_tfidf_top_mr.png" alt="TF-IDF management report"><figcaption>Top TF-IDF — management report</figcaption></figure>
    </div>

    <h2>Distribución de tokens</h2>
    <div class="img-box"><img src="../figures/5a_distribucion_tokens.png" alt="Distribución de tokens"></div>
  </section>

  <!-- ============ EXPLORADOR EMPRESA ============ -->
  <section id="explorador" class="tab-content">
    <div class="control-bar">
      <label for="empresa-select"><b>Empresa:</b></label><br>
      <select id="empresa-select"></select>
    </div>

    <h2 id="emp-title">—</h2>

    <div class="card-row">
      <div class="stat-card"><div class="value" id="emp-gw">—</div><div class="label">GW_index 2024 <span id="emp-gw-delta"></span></div></div>
      <div class="stat-card"><div class="value" id="emp-tone">—</div><div class="label">Tono FinBERT 2024</div></div>
      <div class="stat-card"><div class="value" id="emp-spec">—</div><div class="label">Especificidad climática 2024</div></div>
      <div class="stat-card"><div class="value" id="emp-tokens">—</div><div class="label">Tokens (sus) 2024</div></div>
    </div>

    <h2>Evolución temporal (2022-2024)</h2>
    <div class="grid-2" id="emp-metrics-grid"></div>

    <h2>Cobertura ESRS por año</h2>
    <div class="chart-box" id="emp-radar"></div>

    <h2>Tópicos BERTopic dominantes (sección sostenibilidad)</h2>
    <div id="emp-topics"></div>

    <h2>Datos financieros</h2>
    <div class="table-wrap" id="emp-financials"></div>
  </section>

  <!-- ============ TOPICS ============ -->
  <section id="topics" class="tab-content">
    <div class="rq-tabs" id="topics-subtabs">
      <button class="rq-sub-btn active" data-sub="lda">LDA (K=25)</button>
      <button class="rq-sub-btn" data-sub="bertopic">BERTopic (578 tópicos)</button>
    </div>

    <div id="lda" class="rq-content active">
      <p>LDA entrenado sobre 245.400 párrafos de la sección de sostenibilidad (196 empresas). K óptimo = 25 por coherencia Cv = 0.706 (Decisión 022/036).</p>
      <div class="chart-box" id="chart-lda-coherencia"></div>
      <div class="img-box"><img src="../figures/5b_lda_topics_barplot.png" alt="LDA topics barplot"></div>
      <h3>Tópicos interpretados (mapeo a ESRS, Dec.022/036)</h3>
      <div class="table-wrap">{{ lda_topics_table | safe }}</div>
    </div>

    <div id="bertopic" class="rq-content">
      <p>BERTopic sobre los mismos 245.400 párrafos. 578 tópicos + outliers (40.2%). Triangulación con LDA confirmada (Dec.022/036).</p>
      <div class="img-box"><img src="../figures/5b_bertopic_barchart.png" alt="BERTopic barchart"></div>
      <div class="slider-row">
        <label for="bt-n-slider">Nº de tópicos a mostrar (excluyendo outlier -1):</label>
        <input type="range" id="bt-n-slider" min="5" max="40" value="20">
        <span id="bt-n-label">20</span>
      </div>
      <div class="table-wrap" id="bt-table"></div>

      <h3>Evolución temporal de tópicos seleccionados</h3>
      <div class="checkbox-grid" id="tot-checkboxes"></div>
      <div class="chart-box" id="chart-topics-time"></div>
      <p class="findings">Hallazgo RQ4: T16 "doble materialidad/IROs" crece ×9.3 (107→1001 párrafos, 2022→2024); T17 "Taxonomía UE" ×1.7; T4 "biodiversidad" ×3.3; T3 "agua" ×2.3; T0 "riesgo climático físico" ×2.0.</p>
      <div class="img-box"><img src="../figures/5b_topics_over_time.png" alt="Topics over time"></div>
    </div>
  </section>

  <!-- ============ COMPARADOR ============ -->
  <section id="comparador" class="tab-content">
    <div class="control-bar">
      <label for="comp-year"><b>Año:</b></label><br>
      <select id="comp-year"></select>
    </div>
    <h3>Empresas a comparar (selecciona al menos 2)</h3>
    <div class="checkbox-grid" id="comp-companies"></div>

    <p id="comp-warning" class="findings" style="display:none;">Selecciona al menos 2 empresas para comparar.</p>

    <div id="comp-content">
      <h2>Métricas clave</h2>
      <div class="grid-2" id="comp-metrics-grid"></div>

      <h2>Perfil normalizado (radar, z-score sobre el panel completo de {{ summary.n_docs }} docs)</h2>
      <div class="chart-box" id="comp-radar"></div>

      <h2>Tabla comparativa</h2>
      <div class="table-wrap" id="comp-table"></div>
    </div>
  </section>

  <!-- ============ RESULTADOS RQ ============ -->
  <section id="rq" class="tab-content">
    <p>Análisis estadístico inferencial — Fase 5E (Decisión 026/036). Panel de {{ summary.n_docs }} documentos `sus` (196 empresas).</p>
    <div class="rq-tabs" id="rq-subtabs">
      <button class="rq-sub-btn active" data-sub="rq1">RQ1 — Temas</button>
      <button class="rq-sub-btn" data-sub="rq2">RQ2 — Sector/País</button>
      <button class="rq-sub-btn" data-sub="rq3">RQ3 — Determinantes</button>
      <button class="rq-sub-btn" data-sub="rq4">RQ4 — NFRD→CSRD</button>
    </div>

    <div id="rq1" class="rq-content active">
      <h3>RQ1 — ¿Qué temas predominan en el reporting de sostenibilidad?</h3>
      <div class="findings">
        <ul>
          <li><b>LDA (K=25, Cv=0.706)</b>: 25 tópicos interpretables, mapeados a categorías ESRS en 7 bloques (E1, E2-E4, E5, S1, S2-S3, G1, + tópicos genéricos CSRD).</li>
          <li><b>BERTopic</b>: 578 tópicos + 40.2% outliers. Triangulación con LDA confirmada — los temas dominantes coinciden entre ambos modelos.</li>
          <li>Los temas más frecuentes giran en torno a <b>emisiones/riesgo climático (E1)</b>, <b>plantilla propia (S1)</b> y, de forma creciente, <b>doble materialidad / IROs</b> (CSRD).</li>
        </ul>
        Ver detalle completo en la pestaña <b>🧩 Topics</b>.
      </div>
      <div class="img-box"><img src="../figures/5b_topics_over_time.png" alt="Topics over time"></div>
    </div>

    <div id="rq2" class="rq-content">
      <h3>RQ2 — ¿Hay diferencias de contenido y tono por sector y país?</h3>
      <p>Test de Kruskal-Wallis sobre GW_index, tono FinBERT y especificidad climática, agrupando por supersector ICB y por región/país.</p>
      <div class="grid-2">
        <div>
          <h4>Por supersector</h4>
          <div class="table-wrap">{{ kruskal_supersector_table | safe }}</div>
          <div class="img-box"><img src="../figures/5e_gwindex_supersector.png" alt="GW_index por supersector"></div>
        </div>
        <div>
          <h4>Por país</h4>
          <div class="table-wrap">{{ kruskal_pais_table | safe }}</div>
          <div class="img-box"><img src="../figures/5e_gwindex_region.png" alt="GW_index por región"></div>
        </div>
      </div>
      <div class="findings">
        <ul>
          <li>GW_index y especificidad difieren significativamente por sector y región (p &lt; 0.001 en general).</li>
          <li><b>Tech y Financials</b> muestran mayor GW_index; <b>Real Estate</b> mayor especificidad.</li>
          <li>La región <b>Centro</b> (Europa continental) presenta menor GW_index que <b>Nórdicos</b> y <b>UK</b>.</li>
        </ul>
      </div>
    </div>

    <div id="rq3" class="rq-content">
      <h3>RQ3 — Determinantes de especificidad/cobertura y relación tono-especificidad</h3>
      <p>Dos regresiones OLS con errores robustos HC3 (n=577, R² ≈ 0.14-0.16, VIF máx ≈ 2.7-3 — sin problemas de multicolinealidad relevantes).</p>
      <div class="grid-2">
        <div>
          <h4>Modelo 1 — GW_index ~ sector + región + año + tamaño + financieros</h4>
          <div class="table-wrap">{{ reg1_table | safe }}</div>
          <details><summary>VIF — Modelo 1</summary><div class="table-wrap">{{ reg1_vif_table | safe }}</div></details>
        </div>
        <div>
          <h4>Modelo 2 — Tono FinBERT ~ especificidad + sector + región + año + tamaño</h4>
          <div class="table-wrap">{{ reg2_table | safe }}</div>
          <details><summary>VIF — Modelo 2</summary><div class="table-wrap">{{ reg2_vif_table | safe }}</div></details>
        </div>
      </div>
      <div class="findings">
        <ul>
          <li><b>Especificidad → tono positivo</b> (p = 0.003): relación <b>positiva</b>, no apoya la hipótesis simple "más optimismo ↔ menos especificidad" — confirmado a 196 empresas.</li>
          <li>El año 2024 es significativo tanto en el modelo de tono (p &lt; 0.001) <b>como ahora en GW_index tras controles</b> (p = 0.030) — con el doble de empresas, el efecto CSRD ya no es meramente compositivo.</li>
          <li>El efecto de tamaño (log-capitalización) sobre GW_index, significativo en la muestra de 97 empresas, <b>no se replica</b> con 196 (p = 0.72).</li>
          <li><b>Financials</b> (+2.03, p&lt;0.001) y <b>Technology</b> (+1.34, p=0.002) elevan el GW_index frente a Basic Materials; <b>Nórdicos</b> y <b>UK&amp;Irlanda</b> lo elevan frente a Centro.</li>
        </ul>
      </div>
    </div>

    <div id="rq4" class="rq-content">
      <h3>RQ4 — Evolución NFRD (2022-23) → CSRD (2024)</h3>
      <p>Test de Wilcoxon pareado 2022 ↔ 2024 (n=194 empresas con ambos años).</p>
      <div class="table-wrap">{{ pareado_table | safe }}</div>
      <div class="grid-2">
        <div class="img-box"><img src="../figures/5d_gwindex_evolucion.png" alt="GW_index evolución"></div>
        <div class="img-box"><img src="../figures/5e_pareado_2022_2024.png" alt="Test pareado 2022-2024"></div>
      </div>
      <div class="findings">
        <b>Hallazgos confirmados con significación formal (p &lt; 0.05):</b>
        <ul>
          <li><b>GW_index ↑</b> (-0.208 → +0.339, Δ=+0.547, Wilcoxon p=0.0051): hedging↑, especificidad↓, <b>ratio cuantitativo↓</b>.</li>
          <li><b>Tono FinBERT ↓</b> (0.189 → 0.142, p&lt;0.0001): comunicación cada vez menos optimista.</li>
          <li><b>Riesgo climático ↑</b> (+0.055, p&lt;0.0001), <b>oportunidad climática ↓</b> (-0.047, p&lt;0.0001).</li>
          <li><b>n_tokens ↑</b>: las secciones de sostenibilidad crecen +83% en media (11.2k → 20.6k tokens, p&lt;0.0001).</li>
          <li>Especificidad climática sigue sin alcanzar significación (Wilcoxon p = 0.126).</li>
          <li>Promesas vagas (<code>ratio_futuro_sin_cifra</code>) se mantienen estables.</li>
        </ul>
        La transición a CSRD viene acompañada de informes más extensos, con más cobertura ESRS y más
        menciones a doble materialidad — pero también con tono más cauteloso, más hedging y menos cifras
        concretas: un patrón consistente con mayor "ruido regulatorio" y, a la vez, señales textuales de
        posible impresión gestionada (proxy, no prueba directa de greenwashing).
      </div>
    </div>
  </section>

</main>

<footer>
  Fuente: corpus.parquet (Fase 4) + resultados Fase 5 (5A-5E). Ver docs/decisiones.md para el detalle metodológico.
</footer>

<script>
const DATA = {{ data_json | safe }};
const COLORS = ["#157347","#1f5fa6","#c2992b","#0a1d36","#9c4221","#0e7490","#6b21a8","#4d7c0f","#b91c47","#1e3a8a"];

// Estilo global de todos los gráficos Plotly (tipografía IBM Plex, fondos transparentes,
// títulos en serif alineados a la izquierda, sin barra de herramientas).
const PLOT_FONT = { family: "'IBM Plex Sans', sans-serif", size: 12, color: "#15212e" };
const _origNewPlot = Plotly.newPlot.bind(Plotly);
Plotly.newPlot = function (div, data, layout, config) {
  layout = layout || {};
  layout.font = Object.assign({}, PLOT_FONT, layout.font);
  layout.paper_bgcolor = layout.paper_bgcolor || "rgba(0,0,0,0)";
  layout.plot_bgcolor = layout.plot_bgcolor || "rgba(0,0,0,0)";
  layout.colorway = layout.colorway || COLORS;
  layout.margin = layout.margin || { t: 44, b: 40, l: 56, r: 24 };
  layout.legend = Object.assign({ font: { size: 11 } }, layout.legend);
  if (typeof layout.title === "string") {
    layout.title = { text: layout.title };
  }
  if (layout.title && typeof layout.title === "object") {
    layout.title.font = Object.assign({ family: "'IBM Plex Serif', serif", size: 15, color: "#0a1d36" }, layout.title.font);
    if (layout.title.x === undefined) { layout.title.x = 0.01; layout.title.xanchor = "left"; }
  }
  if (layout.xaxis) layout.xaxis = Object.assign({ gridcolor: "#eef1f5", zerolinecolor: "#d8dee6" }, layout.xaxis);
  if (layout.yaxis) layout.yaxis = Object.assign({ gridcolor: "#eef1f5", zerolinecolor: "#d8dee6" }, layout.yaxis);
  config = Object.assign({ responsive: true, displayModeBar: false }, config);
  return _origNewPlot(div, data, layout, config);
};

function formatNum(v) {
  if (v === null || v === undefined || Number.isNaN(v)) return "—";
  if (typeof v !== "number") return v;
  if (Number.isInteger(v)) return v.toLocaleString("es-ES");
  return v.toLocaleString("es-ES", {maximumFractionDigits: 3});
}

function countBy(rows, key) {
  const counts = {};
  rows.forEach(r => { counts[r[key]] = (counts[r[key]] || 0) + 1; });
  return Object.entries(counts).map(([k, n]) => ({ key: k, n })).sort((a, b) => a.n - b.n);
}

// Limpia el nombre BERTopic "12_human rights_rights_human_suppliers" → "human rights · rights · human · suppliers"
function formatTopicName(raw, id) {
  if (raw === undefined || raw === null) return "(sin etiqueta)";
  let parts = String(raw).split("_");
  if (parts.length && String(parts[0]) === String(id)) parts = parts.slice(1);
  const seen = new Set();
  const words = parts.map(p => p.trim()).filter(p => p && !seen.has(p.toLowerCase()) && seen.add(p.toLowerCase()));
  return words.slice(0, 5).join(" · ") || "(sin etiqueta)";
}

// ───────────────────────────── Tabs ─────────────────────────────
document.querySelectorAll("nav.tabs > .tab-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll("nav.tabs > .tab-btn").forEach(b => b.classList.remove("active"));
    document.querySelectorAll("main > .tab-content").forEach(c => c.classList.remove("active"));
    btn.classList.add("active");
    document.getElementById(btn.dataset.tab).classList.add("active");
    window.scrollTo(0, 0);
  });
});

document.querySelectorAll(".rq-tabs").forEach(group => {
  group.querySelectorAll(".rq-sub-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      group.querySelectorAll(".rq-sub-btn").forEach(b => b.classList.remove("active"));
      const parent = group.parentElement;
      group.querySelectorAll(".rq-sub-btn").forEach(b => {
        document.getElementById(b.dataset.sub).classList.remove("active");
      });
      btn.classList.add("active");
      document.getElementById(btn.dataset.sub).classList.add("active");
    });
  });
});

// ───────────────────────────── Overview ─────────────────────────────
function initOverview() {
  const sus = DATA.desc.filter(r => r.seccion === "sus");
  const mr = DATA.desc.filter(r => r.seccion === "mr");

  Plotly.newPlot("chart-tokens-sus", [{
    x: sus.map(r => r.año), y: sus.map(r => r.media), type: "bar", marker: { color: "#2e7d32" },
  }], { title: "Tokens medios — sección sostenibilidad (sus)", margin: { t: 56 }, xaxis: { dtick: 1 } }, { responsive: true });

  Plotly.newPlot("chart-tokens-mr", [{
    x: mr.map(r => r.año), y: mr.map(r => r.media), type: "bar", marker: { color: "#1565c0" },
  }], { title: "Tokens medios — management report (mr)", margin: { t: 56 }, xaxis: { dtick: 1 } }, { responsive: true });

  const traces = DATA.esrs_cols.map((col, i) => ({
    x: DATA.cov_anio.map(r => r.año), y: DATA.cov_anio.map(r => r[col]),
    name: col, mode: "lines+markers", line: { color: COLORS[i % COLORS.length] },
  }));
  Plotly.newPlot("chart-esrs-evolution", traces, {
    title: "Cobertura media por categoría ESRS", margin: { t: 56 }, xaxis: { dtick: 1 },
  }, { responsive: true });

  const bySS = countBy(DATA.panel, "supersector");
  const byCountry = countBy(DATA.panel, "pais");
  Plotly.newPlot("chart-by-supersector", [{
    x: bySS.map(d => d.n), y: bySS.map(d => d.key), type: "bar", orientation: "h", marker: { color: "#2e7d32" },
  }], { title: "Documentos por supersector ICB", margin: { t: 56, l: 160 } }, { responsive: true });

  Plotly.newPlot("chart-by-country", [{
    x: byCountry.map(d => d.n), y: byCountry.map(d => d.key), type: "bar", orientation: "h", marker: { color: "#1565c0" },
  }], { title: "Documentos por país", margin: { t: 56, l: 120 } }, { responsive: true });
}

// ───────────────────────────── Explorador empresa ─────────────────────────────
const EMP_METRICS = {
  "GW_index": "Índice de greenwashing textual (GW_index)",
  "finbert_tone": "Tono FinBERT (positivo - negativo)",
  "climate_specificity_spec": "Especificidad climática (% frases específicas)",
  "climate_sentiment_risk": "Riesgo climático (% frases)",
  "climate_sentiment_opportunity": "Oportunidad climática (% frases)",
  "hedging_ratio": "Ratio de hedging (palabras modales débiles LM)",
  "ratio_cuantitativo": "Ratio de frases cuantitativas",
  "n_tokens": "Nº tokens sección sostenibilidad",
};

function initExplorador() {
  const sel = document.getElementById("empresa-select");
  const empresas = [...new Set(DATA.panel.map(r => r.empresa))].sort();
  empresas.forEach(e => {
    const opt = document.createElement("option");
    opt.value = e; opt.textContent = e;
    sel.appendChild(opt);
  });
  sel.addEventListener("change", () => renderEmpresa(sel.value));
  renderEmpresa(empresas[0]);
}

function renderEmpresa(empresa) {
  const rows = DATA.panel.filter(r => r.empresa === empresa).sort((a, b) => a.año - b.año);
  const last = rows[rows.length - 1];
  const first = rows[0];

  document.getElementById("emp-title").textContent = `${empresa} — ${last.supersector} · ${last.pais}`;
  document.getElementById("emp-gw").textContent = last.GW_index.toFixed(2);
  document.getElementById("emp-gw-delta").textContent = rows.length > 1
    ? ` (${(last.GW_index - first.GW_index >= 0 ? "+" : "") + (last.GW_index - first.GW_index).toFixed(2)} vs ${first.año})`
    : "";
  document.getElementById("emp-tone").textContent = last.finbert_tone.toFixed(3);
  document.getElementById("emp-spec").textContent = (last.climate_specificity_spec * 100).toFixed(1) + "%";
  document.getElementById("emp-tokens").textContent = formatNum(last.n_tokens);

  const grid = document.getElementById("emp-metrics-grid");
  grid.innerHTML = "";
  Object.entries(EMP_METRICS).forEach(([col, label], i) => {
    const div = document.createElement("div");
    div.className = "chart-box"; div.id = `emp-chart-${i}`;
    grid.appendChild(div);
    Plotly.newPlot(div.id, [{
      x: rows.map(r => r.año), y: rows.map(r => r[col]), mode: "lines+markers", line: { color: "#2e7d32" },
    }], { title: label, margin: { t: 56, b: 30, l: 50, r: 20 }, height: 280 }, { responsive: true });
  });

  const radarTraces = rows.map((r, i) => ({
    type: "scatterpolar", r: DATA.esrs_cols.map(c => r[c]), theta: DATA.esrs_cols,
    fill: "toself", name: String(r.año), line: { color: COLORS[i % COLORS.length] },
  }));
  Plotly.newPlot("emp-radar", radarTraces, {
    polar: { radialaxis: { visible: true, range: [0, 1] } }, title: "Cobertura ESRS — radar por año",
  }, { responsive: true });

  const topicsDiv = document.getElementById("emp-topics");
  topicsDiv.innerHTML = "";
  rows.forEach(r => {
    const bt = DATA.bt_doc.find(b => b.doc_id === r.doc_id);
    if (!bt) return;
    const raw = DATA.bt_topic_names_all[bt.topic_dominante];
    const name = formatTopicName(raw, bt.topic_dominante);
    const p = document.createElement("p");
    p.innerHTML = `<b>${r.año}</b>: tópico dominante <code>#${bt.topic_dominante}</code> ${name} ` +
      `<small>(${(bt.topic_dominante_share * 100).toFixed(0)}% de los párrafos no-outlier; ` +
      `${(bt.outlier_share * 100).toFixed(0)}% párrafos outlier)</small>`;
    topicsDiv.appendChild(p);
  });

  const finCols = [["año", "Año"], ["capitalización", "Capitalización"], ["ROA", "ROA"],
                   ["ROE", "ROE"], ["deuda_equity", "Deuda/Equity"], ["total_assets", "Activos totales"]];
  let html = '<table class="data-table"><thead><tr>' + finCols.map(c => `<th>${c[1]}</th>`).join("") + "</tr></thead><tbody>";
  rows.forEach(r => {
    html += "<tr>" + finCols.map(c => `<td>${formatNum(r[c[0]])}</td>`).join("") + "</tr>";
  });
  html += "</tbody></table>";
  document.getElementById("emp-financials").innerHTML = html;
}

// ───────────────────────────── Topics ─────────────────────────────
function initTopics() {
  const coh = DATA.lda_coherencia;
  Plotly.newPlot("chart-lda-coherencia", [{
    x: coh.map(r => r.K), y: coh.map(r => r.coherencia_Cv), mode: "lines+markers", line: { color: "#2e7d32" },
  }], {
    title: "Coherencia Cv por K", margin: { t: 56 },
    shapes: [{ type: "line", x0: 15, x1: 15, y0: 0, y1: 1, yref: "paper", line: { color: "red", dash: "dash" } }],
    annotations: [{ x: 15, y: 1, yref: "paper", text: "K óptimo", showarrow: false, yshift: 10 }],
  }, { responsive: true });

  const slider = document.getElementById("bt-n-slider");
  slider.addEventListener("input", renderBertopicTable);
  renderBertopicTable();

  const container = document.getElementById("tot-checkboxes");
  DATA.bt_top.forEach((t, i) => {
    const label = document.createElement("label");
    const input = document.createElement("input");
    input.type = "checkbox"; input.value = t.Topic; input.checked = i < 6;
    input.addEventListener("change", renderTopicsOverTime);
    label.appendChild(input);
    label.append(` #${t.Topic} · ${formatTopicName(t.Name, t.Topic)}`);
    container.appendChild(label);
  });
  renderTopicsOverTime();
}

function renderBertopicTable() {
  const n = parseInt(document.getElementById("bt-n-slider").value);
  document.getElementById("bt-n-label").textContent = n;
  const rows = DATA.bt_top.slice(0, n);
  let html = '<table class="data-table"><thead><tr><th>Topic</th><th>Párrafos</th><th>Nombre</th><th>Palabras representativas</th></tr></thead><tbody>';
  rows.forEach(r => {
    html += `<tr><td>${r.Topic}</td><td>${formatNum(r.Count)}</td><td class="wrap">${r.Name}</td><td class="wrap">${r.Representation}</td></tr>`;
  });
  html += "</tbody></table>";
  document.getElementById("bt-table").innerHTML = html;
}

function renderTopicsOverTime() {
  const checked = [...document.querySelectorAll("#tot-checkboxes input:checked")].map(cb => parseInt(cb.value));
  const traces = checked.map((topicId, i) => {
    const rows = DATA.topics_over_time.filter(r => r.Topic === topicId).sort((a, b) => a.Timestamp - b.Timestamp);
    return {
      x: rows.map(r => r.Timestamp), y: rows.map(r => r.Frequency), mode: "lines+markers",
      name: "#" + topicId + " " + formatTopicName(DATA.bt_topic_names[topicId], topicId),
      line: { color: COLORS[i % COLORS.length] },
    };
  });
  Plotly.newPlot("chart-topics-time", traces, {
    title: "Frecuencia (nº párrafos) por año", margin: { t: 56 },
  }, { responsive: true });
}

// ───────────────────────────── Comparador ─────────────────────────────
const COMP_METRICS = {
  "GW_index": "GW_index (mayor = más señales de greenwashing textual)",
  "finbert_tone": "Tono FinBERT",
  "climate_specificity_spec": "Especificidad climática",
  "climate_sentiment_risk": "Riesgo climático",
  "climate_sentiment_opportunity": "Oportunidad climática",
  "hedging_ratio": "Ratio de hedging",
  "ratio_cuantitativo": "Ratio cuantitativo",
};

function initComparador() {
  const yearSel = document.getElementById("comp-year");
  const years = [...new Set(DATA.panel.map(r => r.año))].sort((a, b) => b - a);
  years.forEach(y => {
    const opt = document.createElement("option");
    opt.value = y; opt.textContent = y;
    yearSel.appendChild(opt);
  });
  yearSel.addEventListener("change", populateCompanyCheckboxes);
  populateCompanyCheckboxes();
}

function populateCompanyCheckboxes() {
  const year = parseInt(document.getElementById("comp-year").value);
  const empresas = DATA.panel.filter(r => r.año === year).map(r => r.empresa).sort();
  const container = document.getElementById("comp-companies");
  container.innerHTML = "";
  empresas.forEach((e, i) => {
    const label = document.createElement("label");
    const input = document.createElement("input");
    input.type = "checkbox"; input.value = e; input.checked = i < 3;
    input.addEventListener("change", renderComparador);
    label.appendChild(input);
    label.append(" " + e);
    container.appendChild(label);
  });
  renderComparador();
}

function renderComparador() {
  const year = parseInt(document.getElementById("comp-year").value);
  const selected = [...document.querySelectorAll("#comp-companies input:checked")].map(cb => cb.value);
  const rows = DATA.panel.filter(r => r.año === year && selected.includes(r.empresa));

  if (selected.length < 2) {
    document.getElementById("comp-content").style.display = "none";
    document.getElementById("comp-warning").style.display = "block";
    return;
  }
  document.getElementById("comp-content").style.display = "block";
  document.getElementById("comp-warning").style.display = "none";

  const grid = document.getElementById("comp-metrics-grid");
  grid.innerHTML = "";
  Object.entries(COMP_METRICS).forEach(([col, label], i) => {
    const div = document.createElement("div");
    div.className = "chart-box"; div.id = `comp-chart-${i}`;
    grid.appendChild(div);
    const sorted = [...rows].sort((a, b) => a[col] - b[col]);
    Plotly.newPlot(div.id, [{
      x: sorted.map(r => r.empresa), y: sorted.map(r => r[col]), type: "bar",
      marker: { color: sorted.map((_, idx) => COLORS[idx % COLORS.length]) },
    }], { title: label, height: 300, margin: { t: 56, b: 90 } }, { responsive: true });
  });

  const radarTraces = rows.map((r, i) => ({
    type: "scatterpolar",
    r: DATA.radar_cols.map(c => (r[c] - DATA.radar_stats[c].mean) / DATA.radar_stats[c].std),
    theta: DATA.radar_cols, fill: "toself", name: r.empresa, line: { color: COLORS[i % COLORS.length] },
  }));
  Plotly.newPlot("comp-radar", radarTraces, {
    polar: { radialaxis: { visible: true } }, title: `Perfil z-score — ${year}`,
  }, { responsive: true });

  const cols = [["empresa", "Empresa"], ["supersector", "Supersector"], ["pais", "País"],
                ["GW_index", "GW_index"], ["finbert_tone", "Tono"], ["climate_specificity_spec", "Especificidad"],
                ["n_tokens", "Tokens"], ["capitalización", "Capitalización"]];
  let html = '<table class="data-table"><thead><tr>' + cols.map(c => `<th>${c[1]}</th>`).join("") + "</tr></thead><tbody>";
  rows.forEach(r => {
    html += "<tr>" + cols.map(c => `<td>${formatNum(r[c[0]])}</td>`).join("") + "</tr>";
  });
  html += "</tbody></table>";
  document.getElementById("comp-table").innerHTML = html;
}

// ───────────────────────────── Init ─────────────────────────────
initOverview();
initExplorador();
initTopics();
initComparador();
</script>
</body>
</html>
